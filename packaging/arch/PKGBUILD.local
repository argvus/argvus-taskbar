# Maintainer: William C. Canin
pkgname=argvus-taskbar
pkgver=0.1.0
pkgrel=1
pkgdesc="Waybar top panel integration for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-taskbar"
license=('GPL-3.0-only')
depends=(
  'argvus-app-profiles'
  'argvus-appearance'
  'argvus-calendar'
  'argvus-control-panel'
  'argvus-widget-telemetry'
  'argvus-network'
  'argvus-power'
  'argvus-pwvucontrol'
  'argvus-session'
  'argvus-shell'
  'argvus-storage'
  'argvus-waybar'
  'foot'
  'hyprland'
  'jq'
  'libnotify'
  'lm_sensors'
  'pamixer'
  'playerctl'
  'power-profiles-daemon'
  'procps-ng'
  'rofi'
  'wireplumber'
)
optdepends=(
  'argvus: dispatcher used by taskbar click actions'
  'nvidia-utils: NVIDIA GPU temperature popup'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}
