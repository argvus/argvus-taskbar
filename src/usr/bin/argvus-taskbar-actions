#!/usr/bin/env sh

# Existing Waybar profiles call this script for the calendar. Hand that click
# to the dedicated launcher before bootstrap and workspace discovery can delay
# pointer capture.
if [ "${1:-}" = "--cal" ] && [ -x /usr/lib/argvus/taskbar-calendar/waybar-launcher ]; then
  shift
  exec /usr/lib/argvus/taskbar-calendar/waybar-launcher "$@"
fi

ARGVUS_BOOTSTRAP="${ARGVUS_BOOTSTRAP:-${ARGVUS_SYSTEM_CONFIG:-/usr/share/argvus}/session/sh/bootstrap.sh}"
# shellcheck disable=SC1090,SC1091
. "$ARGVUS_BOOTSTRAP"
# shellcheck disable=SC1091
. /usr/share/argvus/lib/i18n.sh

mkdir -p "$WAYBAR_CACHE_DIR"

case "$XDG_SESSION_DESKTOP" in
  Hyprland)
    DIR="hypr"
    CURRENT_WS=$(hyprctl activeworkspace -j | jq -r '.id')
    ;;
  sway)
    DIR="sway"
    CURRENT_WS=$(swaymsg -t get_workspaces | jq -r '.[] | select(.focused).name')
    ;;
  *)
    DIR=""
    CURRENT_WS=""
    ;;
esac

require_session() {
  case "$XDG_SESSION_DESKTOP" in
    Hyprland | sway) return 0 ;;
    *)
      notify-send "argvus-taskbar" "$(argvus_tr taskbar session.unsupported "session=${XDG_SESSION_DESKTOP:-unknown}")"
      exit 1
      ;;
  esac
}

go_workspace() {
  require_session
  case "$XDG_SESSION_DESKTOP" in
    Hyprland) hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" ;;
    sway)     swaymsg workspace "$1" ;;
  esac
}

switch_keyboard_layout() {
  require_session
  case "$XDG_SESSION_DESKTOP" in
    Hyprland)
      exec sh "$(paths_config session/sh/keyboard-layout-cycle.sh)" cycle
      ;;
    sway)
      swaymsg input type:keyboard xkb_switch_layout next
      ;;
  esac
}

power_menu() {
  [ -n "$DIR" ] || require_session
  exec sh "$(paths_config "power/sh/hypr-power-menu.sh")"
}

term_exec() {
  _class="$1"
  _profile="$2"
  shift 2
  exec argvus tui-terminal --class "$_class" --term kitty --profile "$_profile" -- "$@"
}

sidebar_toggle() {
  exec sh "$(paths_config control-panel/sh/toggle-sidebar.sh)"
}

case $1 in
  --cal)
    # Compatibility fallback for calendar packages without the launcher.
    argvus --calendar
    ;;
  --mem)
    term_exec argvus-taskbar-mem taskbar-monitor --title "$(argvus_tr taskbar monitor.memory.title)" argvus --system-monitor --panel --mem
    ;;
  --cpu)
    term_exec argvus-taskbar-cpu taskbar-monitor --title "$(argvus_tr taskbar monitor.cpu.title)" argvus --system-monitor --panel --cpu
    ;;
  --cpu-temp)
    if argvus widget-telemetry block cpu-temp --available; then
      term_exec cpu-temp-popup taskbar-monitor --title "$(argvus_tr taskbar prompt.press_q_to_close)" argvus sensors
    fi
    go_workspace "$CURRENT_WS"
    ;;
  --gpu-temp)
    if argvus widget-telemetry block gpu --available; then
      term_exec gpu-temp-popup taskbar-monitor --title "$(argvus_tr taskbar prompt.press_q_to_close)" argvus --system-monitor --panel --gpu
    fi
    go_workspace "$CURRENT_WS"
    ;;
  --power-menu)
    power_menu
    ;;
  --layout-keyboard)
    switch_keyboard_layout
    ;;
  --layout-keyboard-settings)
    exec argvus --control-center --keyboard
    ;;
  --sidebar-toggle)
    sidebar_toggle
    ;;
  *)
    notify-send "argvus-taskbar" "$(argvus_tr taskbar parameter.invalid "parameter=${1:-empty}")"
    exit 1
    ;;
esac
