{
  "reload_style_on_change": true,
  "fixed-center": false,
  "position": "top",
  "mode": "dock",
  "margin-top": 1,
  "height": 28,
  "margin-left": 1,
  "margin-right": 1,
  "margin-bottom": 1,

  "group/left1": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },
  "group/left2": {
    "orientation": "inherit",
    "modules": ["custom/spotify-mpris", "mpris"]
  },
  "group/right-0": {
    "orientation": "inherit",
    "modules": ["custom/date", "clock#time"]
  },
  "group/right-1": {
    "orientation": "inherit",
    "spacing": 2,
    "modules": ["custom/network", "power-profiles-daemon", "hyprland/language", "battery", "memory", "cpu", "custom/cpu-temp", "custom/gpu-temp"]
  },
  "group/right-search": {
    "orientation": "inherit",
    "modules": [
      "custom/search"
    ]
  },
  "group/right-2": {
    "orientation": "inherit",
    "modules": [
      "custom/storage",
      "custom/recording",
      "custom/bluetooth",
      "pulseaudio#input",
      "pulseaudio#output",
      "custom/keep-awake",
      "custom/notifications"
    ]
  },
  "modules-left": ["group/left1", "group/left2"],
  "modules-center": ["custom/icon-window", "hyprland/submap", "hyprland/window"],
  "modules-right": [
    "tray",
    "group/right-search",
    "group/right-2",
    "group/right-1",
    "group/right-0",
    "custom/power",
    "custom/settings"
  ],
  "custom/icon-window": {
    "format": "<span font_family='Symbols Nerd Font Mono'></span> "
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "tooltip": false
  },
  "hyprland/submap": {
    "format": "[ {} ] ",
    "max-length": 20,
    "tooltip": false
  },
  "custom/window-or-mpris": {
    "exec": "/usr/share/argvus/taskbar/sh/waybar-window-or-mpris.sh",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false,
    "disable-scroll": true,
    "sort-by-number": true,
    "tooltip": false,
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "hyprland/language": {
    "format": "<span font_family='Symbols Nerd Font Mono'>󰌌</span> {short}",
    "on-click": "argvus-taskbar-actions --layout-keyboard",
    "on-click-right": "argvus-taskbar-actions --layout-keyboard-settings"
  },
  "cpu": {
    "interval": 5,
    "format": "<span font_family='Symbols Nerd Font Mono'></span> {usage}%",
    "on-click": "argvus-taskbar-actions --cpu"
  },
  "custom/cpu-temp": {
    "exec-if": "/usr/share/argvus/widget-telemetry/sh/cpu-temp.sh --available",
    "exec": "/usr/share/argvus/widget-telemetry/sh/cpu-temp.sh",
    "interval": 10,
    "format": "<span font_family='Symbols Nerd Font Mono'></span>{}°C",
    "on-click": "argvus-taskbar-actions --cpu-temp"
  },
  "custom/gpu-temp": {
    "exec-if": "/usr/share/argvus/widget-telemetry/sh/gpu.sh --available-temp",
    "exec": "/usr/share/argvus/widget-telemetry/sh/gpu.sh --temp",
    "interval": 15,
    "format": "<span font_family='Symbols Nerd Font Mono'>󰢮</span> {}",
    "tooltip": false,
    "on-click": "argvus-taskbar-actions --gpu-temp"
  },
  "memory": {
    "interval": 5,
    "format": "<span font_family='Symbols Nerd Font Mono'></span> {percentage}%",
    "on-click": "argvus-taskbar-actions --mem"
  },
  "custom/date": {
    "exec": "/usr/share/argvus/taskbar/sh/waybar-date.sh",
    "interval": 30,
    "format": "<span font_family='Symbols Nerd Font Mono'>󰸗</span> {}",
    "tooltip": false,
    // The built-in waybar calendar tooltip is disabled on purpose: the
    // Argvus calendar popup (argvus-taskbar-calendar) is used instead.
    // "tooltip-format": "<span>{calendar}</span>",
    // "calendar": {
    //   "mode": "month",
    //   "weeks-pos": "right",
    //   "mode-mon-col": 3,
    //   "on-click-right": "mode",
    //   "format": {
    //     "month": "<span color='#ffead3'><b>{}</b></span>",
    //     "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
    //     "today": "<span color='#ff6699'><b>{}</b></span>"
    //   }
    // },
    "on-click": "/usr/lib/argvus-taskbar-calendar/waybar-launcher --surface {x_root} {y_root}"
  },
  "clock#time": {
    "format": "<span font_family='Symbols Nerd Font Mono'>󰅐</span> {:L%H:%M}",
    "tooltip": false
  },
  "custom/network": {
    "exec": "/usr/share/argvus/network/sh/waybar-network.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 10,
    "tooltip": true,
    "nospacing": 1,
    "on-click": "argvus-networkctl manager",
    "on-click-right": "argvus-networkctl toggle"
  },
  "custom/bluetooth": {
    "exec-if": "/usr/share/argvus/network/sh/bluetooth-control.sh available",
    "exec": "/usr/share/argvus/network/sh/bluetooth-control.sh waybar",
    "return-type": "json",
    "format": "{}",
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "/usr/share/argvus/network/sh/bluetooth-control.sh toggle",
    "on-click-right": "/usr/share/argvus/network/sh/bluetooth-control.sh manager",
    "interval": 30
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰊚",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "<span font_family='Symbols Nerd Font Mono'>󰂄</span> {capacity}%",
    "format-plugged": "<span font_family='Symbols Nerd Font Mono'>󰚥</span> {capacity}%",
    "format-full": "<span font_family='Symbols Nerd Font Mono'>󰁹</span> {capacity}%",
    "format-icons": ["<span font_family='Symbols Nerd Font Mono'>󰂎</span>", "<span font_family='Symbols Nerd Font Mono'>󰁺</span>", "<span font_family='Symbols Nerd Font Mono'>󰁻</span>", "<span font_family='Symbols Nerd Font Mono'>󰁼</span>", "<span font_family='Symbols Nerd Font Mono'>󰁽</span>", "<span font_family='Symbols Nerd Font Mono'>󰁾</span>", "<span font_family='Symbols Nerd Font Mono'>󰁿</span>", "<span font_family='Symbols Nerd Font Mono'>󰂀</span>", "<span font_family='Symbols Nerd Font Mono'>󰂁</span>", "<span font_family='Symbols Nerd Font Mono'>󰂂</span>", "<span font_family='Symbols Nerd Font Mono'>󰁹</span>"],
    "tooltip-format": "{timeTo} • {power} W"
  },
  "pulseaudio#input": {
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "format": "{format_source}",
    "tooltip-format": "{format_source} {source_volume}%",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    "on-click": "argvus --control-center audio input",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%+ -l 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-"
  },
  "pulseaudio#output": {
    "format": "{icon}",
    "tooltip-format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    "on-click": "argvus --control-center audio output",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "custom/notifications": {
    "exec": "/usr/share/argvus/taskbar/sh/waybar-notifications.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "argvus-notifications dnd toggle",
    "tooltip": true
  },
  "custom/keep-awake": {
    "exec": "/usr/share/argvus/taskbar/sh/waybar-keep-awake.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "/usr/share/argvus/power/sh/keep-awake.sh toggle",
    "tooltip": true
  },
  "custom/settings": {
      "exec": "[ \"$(cat ${XDG_CACHE_HOME:-$HOME/.cache}/argvus/waybar/sidebar-state 2>/dev/null)\" = 'open' ] && echo '' || echo '󰍜'",
      "interval": 1,
      "format": "{}",
      "tooltip": false,
      "on-click": "argvus-taskbar-actions --sidebar-toggle"
  },
  "custom/recording": {
    "exec": "/usr/share/argvus/hyprland/sh/hypr-screenshot.sh --video-full-status",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "on-click": "/usr/share/argvus/hyprland/sh/hypr-screenshot.sh --video-full",
    "on-click-right": "/usr/share/argvus/hyprland/sh/hypr-screenshot.sh --video-full-stop"
  },
  "custom/search": {
    "format": "",
    "tooltip": false,
    "on-click": "argvus-launcher"
  },
  // Removable storage (UDisks2). Compact Nerd Font icon near recording/sound;
  // left = choose device and open, right = full context menu.
  "custom/storage": {
    "exec": "argvus --removable-devices watch",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "hide-empty-text": true,
    "on-click": "/usr/share/argvus/removable-devices/sh/removable-devices-menu.sh"
    // "on-click-right": "argvus-removable-devices devices"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 12,
    "show-passive-items": false
  },
  "custom/spotify-mpris": {
    "exec": "/usr/share/argvus/taskbar/sh/waybar-spotify-mpris.sh",
    "on-click": "/usr/share/argvus/taskbar/sh/waybar-spotify-playpause.sh",
    "on-click-right": "/usr/share/argvus/taskbar/sh/waybar-spotify-focus.sh",
    "format": "{}",
    "format-paused": "{}",
    "return-type": "text",
    "max-length": 80,
    "interval": 5,
    "tooltip": false
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "<span color='grey'>{status_icon} {dynamic}</span>",
    "max-length": 80,
    "interval": 5,
    "player-icons": {
      "default": "<span font_family='Symbols Nerd Font Mono'>󰎇</span>",
      "mpv": "<span font_family='Symbols Nerd Font Mono'>󰎇</span>"
    },
    "status-icons": {
      "paused": "<span font_family='Symbols Nerd Font Mono'>󰏥</span>"
    },
    "ignored-players": ["spotify", "audacious", "rhythmbox", "strawberry", "lollypop", "firefox", "chromium", "brave", "edge", "vivaldi", "opera", "google-chrome"]
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "argvus-taskbar-actions --power-menu"
  }
}
